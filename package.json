{
  "name": "scheduler",
  "version": "4.0.0",
  "description": "HL Scheduler desktop app",
  "author": "anonymous",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:icons": "node scripts/gen-icons.mjs",
    "test": "node --experimental-specifier-resolution=node scripts/sanity-check.mjs",
    "dist:portable": "npm run build && npm run gen:icons && electron-builder --win portable && node scripts/copy-portable-to-dist.cjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.11",
    "html2canvas": "^1.4.1",
    "nodemailer": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.20",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "postcss": "^8.4.49",
    "rcedit": "^3.1.0",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.scheduler.app",
    "productName": "Scheduler",
    "artifactName": "${productName}-4.0.${ext}",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico"
    }
  }
}
