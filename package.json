{
  "name": "scheduler",
  "version": "5.0.0",
  "description": "HL Scheduler web app",
  "author": "anonymous",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-specifier-resolution=node scripts/sanity-check.mjs",
    "test:collab": "node --experimental-specifier-resolution=node scripts/collab-sanity-check.mjs",
    "cf:build:public": "node scripts/cloudflare/build-pages.mjs --role public",
    "cf:build:admin": "node scripts/cloudflare/build-pages.mjs --role admin",
    "cf:render:worker:public": "node scripts/cloudflare/render-wrangler-config.mjs --surface public",
    "cf:render:worker:admin": "node scripts/cloudflare/render-wrangler-config.mjs --surface admin",
    "cf:smoke": "node scripts/cloudflare/smoke-test.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.11",
    "html2canvas": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.1"
  }
}
