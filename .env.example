# Public schedules read API base URL
# public app: public worker URL, admin app: admin worker URL
VITE_PUBLIC_SCHEDULES_API_BASE=

# Public schedules write API base URL
# public app: public worker URL, admin app: admin worker URL
VITE_PUBLIC_SCHEDULES_WRITE_API_BASE=

# Web app role: public | admin
VITE_APP_ROLE=public

# Auth API base URL (register/login/me/logout)
# public app: public worker URL, admin app: admin worker URL
VITE_AUTH_API_BASE=

# Admin API base URL (user approval/reset-password)
# both apps: admin worker URL
VITE_ADMIN_API_BASE=

# Public pages URL (for auto-redirect after login, optional)
VITE_PUBLIC_APP_URL=

# Admin pages URL (for auto-redirect after login, optional)
VITE_ADMIN_APP_URL=

# Shared source schedule id (optional)
VITE_SHARED_SCHEDULE_ID=
